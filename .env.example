# App

# Auth — required, at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-secret-at-least-32-chars"

# Development database
DATABASE_URL="postgresql://user:password@localhost:5432/saas_dashboard?schema=public"

# Isolated database used by Playwright. The database name MUST contain "test":
# the E2E global setup refuses to reset anything else.
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/saas_dashboard_test?schema=public"

# Optional distributed rate limiting (recommended in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
