{
  "name": "saas-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "perf:budget": "node scripts/perf-budget.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "lighthouse:budget": "node scripts/lighthouse-budget.mjs",
    "check:pages": "node scripts/check-page-size.mjs",
    "check:source": "node scripts/check-source-size.mjs",
    "check:tests": "node scripts/check-tests.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:pages && npm run check:source && npm run check:tests && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.107.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^14.14.0",
    "geist": "^1.9.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.0.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^24.0.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.40.0",
    "postcss": "^8.0.0",
    "prisma": "^5.7.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  }
}
