{
  "name": "saas-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "perf:budget": "node scripts/perf-budget.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "lighthouse:budget": "node scripts/lighthouse-budget.mjs",
    "check:pages": "node scripts/check-page-size.mjs",
    "check:source": "node scripts/check-source-size.mjs",
    "check:tests": "node scripts/check-tests.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@prisma/client": "^5.7.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^14.13.0",
    "geist": "^1.9.2",
    "jose": "^6.2.15",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.0.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "playwright": "^1.40.0",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  }
}
